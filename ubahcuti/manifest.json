{
    "manifest_version": 3,
    "name": "E-Cuti Permintaan Ubah Status Cuti",
    "version": "1.0",
    "description": "Generate teks permintaan ubah status cuti dari data E-Cuti yang dicentang.",
    "permissions": [
        "activeTab",
        "scripting"
    ],
    "action": {
        "default_popup": "popup.html"
    },
    "content_scripts": [
        {
            "matches": [
                "*://e-cuti.semarangkota.go.id/*"
            ],
            "js": [
                "../ecuti/content.js"
            ]
        }
    ]
}
